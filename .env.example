# postgresql url
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Whether allow feature
ALLOW_REGISTER=false
ALLOW_OPENAPI=true

# For analyze tianji self
WEBSITE_ID=

# For secury
# Replace with a persistent random secret; the placeholder generates a new secret on each startup.
JWT_SECRET=replace-me-with-a-random-string
JWT_ISSUER= # default is `tianji.msgbyte.com`
JWT_AUDIENCE= # default is `msgbyte.com`

# ClickHouse
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
